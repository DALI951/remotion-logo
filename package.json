{
  "name": "remotion-logo",
  "version": "1.0.0",
  "private": true,
  "description": "OpenCode logo intro + ChatGPT bloom intro — Remotion compositions rendered on GitHub Actions",
  "scripts": {
    "studio": "remotion studio",
    "render:opencode": "remotion render OpenCodeIntro out/OpenCodeIntro.mp4",
    "render:chatgpt": "remotion render ChatGPTIntro out/ChatGPTIntro.mp4",
    "render:all": "npm run render:opencode && npm run render:chatgpt",
    "verify": "python tools/verify_frames.py",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
